# Set to "true" while the site is a private preview (noindex, robots Disallow: /).
# Flip to "false" (and redeploy) for the formal public launch.
NEXT_PUBLIC_NOINDEX=true

# Canonical site origin, no trailing slash. Used for canonicals, sitemap, llms.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://recentcodes.vercel.app
