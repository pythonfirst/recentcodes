# Set to "true" while the site is a private preview (noindex, robots Disallow: /).
# Flip to "false" (and redeploy) for the formal public launch.
NEXT_PUBLIC_NOINDEX=true

# Canonical site origin, no trailing slash. Used for canonicals, sitemap, llms.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://recentcodes.vercel.app

# --- Automated ingestion (server-only; set in Vercel, never commit values) ---
# Public Supabase values: the site reads published codes (rc_codes) with the publishable key; RLS allows SELECT only.
SUPABASE_URL=https://yuriszkzskrxtnmphszg.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Must equal Vault secret recentcodes_fn_secret (guards the rc_ingest RPC).
RC_SUPABASE_FN_SECRET=
# Must equal Vault secret recentcodes_cron_secret (Bearer that pg_cron sends to /api/ingest/*).
RC_CRON_SECRET=
# Discord bot that can read #code-feed in the recentcodes server.
DISCORD_BOT_TOKEN=
# Optional LLM cross-check through Vercel AI Gateway (off when unset). Use a free-tier model id.
AI_GATEWAY_MODEL=
